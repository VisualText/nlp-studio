# GitHub sign-in for the NLP Studio app -- see INSTALL.md, "Switching to GitHub sign-in".
#
# Copy to studio/deploy/.env on the server (it is never committed), fill in, and keep it
# readable by its owner only:
#
#     cp env.example .env && chmod 600 .env
#
# All four GitHub values, or none. With NLP_STUDIO_REQUIRE_SIGN_IN=1 the app refuses to
# start unless all four are set -- keep it on whenever nginx no longer asks for a password.

# The GitHub App's client ID (not secret) and client secret (secret: this file only).
NLP_STUDIO_GITHUB_CLIENT_ID=
NLP_STUDIO_GITHUB_CLIENT_SECRET=

# The GitHub logins allowed in, comma-separated. Anyone else who signs in is turned away.
NLP_STUDIO_USERS=

# Where the page is served. GitHub sends people back to <this>/api/auth/callback, which
# must match the GitHub App's callback URL exactly.
NLP_STUDIO_PUBLIC_URL=https://studio.visualtext.org/studio

NLP_STUDIO_REQUIRE_SIGN_IN=1
