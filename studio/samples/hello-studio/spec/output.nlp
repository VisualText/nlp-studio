###############################################
# FILE: output
# SUBJ: Write what was found to output.json
###############################################

@CODE
L("root") = getconcept(findroot(),"greetings");
# "app" as well as the name, so this runs on every engine: on Linux, NLPPlus 2.2.37
# and earlier could not create a file opened by name alone, and wrote nothing. The
# engine empties output/ before every run, so appending starts from an empty file.
L("out") = openfile("output.json","app");
L("out") << "{\"greetings\": " << numval(L("root"),"count") << "}";
closefile(L("out"));
@@CODE
